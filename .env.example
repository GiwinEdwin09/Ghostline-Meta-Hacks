# Back-end settings (build plan Appendix A). Store the real values in the Modal secret "ghostline".
MODEL_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
PHYSICIST_MODEL=muse-wonder-1.0
SCENE_MODEL=muse-wonder-1.0
SAM_MODEL=sam-3.1
REVIEWER_BASE_URL=
REVIEWER_MODEL=
REVIEWER_API_KEY=
DATABASE_URL=
APP_PASSCODE=
BUDGET_USD_DAILY=20
BUDGET_USD_PER_EXPERIMENT=3
LLM_MODE=live
CORS_ORIGINS=http://localhost:3000

# Optional settings, shown with their defaults (build plan Parts 4, 21, 22 and 28). Uncomment one to
# change it; an empty value would override the default with nothing.
# VOLUME_ROOT=/data                    where the Modal Volume is mounted (any directory locally)
# DB_POOL_MIN=1
# DB_POOL_MAX=5
# MAX_UPLOAD_BYTES=1073741824          1 GiB
# UPLOAD_CHUNK_BYTES=8388608           8 MiB
# MAX_FRAMES=15000                     SAM's per-request limit
# MAX_OPEN_UPLOADS_PER_EXPERIMENT=10
# JSON_BODY_LIMIT_BYTES=1048576
# ANALYSES_PER_IP_PER_DAY=10
# PASSCODE_FAILURES_PER_10MIN=20
# MODAL_APP_NAME=ghostline
# JOB_HEARTBEAT_INTERVAL_S=5
# JOB_HEARTBEAT_TIMEOUT_S=60
# JOB_QUEUED_TIMEOUT_S=180
# SIMULATE_TIMEOUT_S=20
# META_HEALTH_TTL_S=60
# STALE_UPLOAD_HOURS=24
# LLM_CACHE_DIR=                       recorded model calls; default is /cache on the Volume
# GHOSTLINE_KEEP_WARM=                 set to 1 when deploying for judging (modal_app.py)
